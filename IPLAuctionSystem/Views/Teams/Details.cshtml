@model IPLAuctionSystem.Models.Team

@{
    ViewData["Title"] = "Franchise Profile";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Teams
        </a>
        <div class="btn-group shadow">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning px-4">
                <i class="fa-solid fa-pen-to-square me-2"></i>Edit Profile
            </a>
        </div>
    </div>

    <div class="row g-4">
        @* Left Column: Franchise Identity *@
        <div class="col-md-4">
            <div class="card bg-dark border-secondary shadow-lg text-center p-4 h-100">
                @if (!string.IsNullOrEmpty(Model.TeamLogo))
                {
                    <div class="mx-auto mb-4 p-3 bg-white rounded-3 shadow-sm d-flex align-items-center justify-content-center"
                         style="width: 180px; height: 180px;">
                        <img src="~/images/teams/@Model.TeamLogo" class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="@Model.Name Logo" />
                    </div>
                }
                else
                {
                    <div class="mx-auto rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center mb-4 shadow"
                         style="width: 120px; height: 120px; font-size: 3.5rem; font-weight: 800;">
                        @Model.Name.Substring(0, 1)
                    </div>
                }

                <h2 class="text-white fw-bold text-uppercase tracking-tight">@Model.Name</h2>
                <div class="badge bg-warning text-dark mb-3 px-3 py-2">OFFICIAL FRANCHISE</div>

                <hr class="border-secondary mx-4" />

                <div class="text-start mt-3 px-3">
                    <label class="text-secondary small text-uppercase fw-bold d-block mb-1">Corporate Owner</label>
                    <p class="text-white fs-5"><i class="fa-solid fa-building me-2 text-info"></i>@Model.Owner</p>
                </div>
            </div>
        </div>

        @* Right Column: Stats & Financials *@
        <div class="col-md-8">
            <div class="card bg-dark border-secondary shadow-lg h-100">
                <div class="card-header bg-accent border-secondary py-3">
                    <h5 class="mb-0 text-white fw-bold">
                        <i class="fa-solid fa-chart-pie me-2 text-warning"></i>Franchise Overview
                    </h5>
                </div>
                <div class="card-body p-4 p-lg-5">
                    <div class="row g-4">
                        @* Financial Purse *@
                        <div class="col-sm-6">
                            <div class="p-4 rounded-4 border border-secondary shadow-sm" style="background: linear-gradient(145deg, #1e293b, #0f172a);">
                                <label class="text-secondary small text-uppercase fw-bold mb-2 d-block">Available Purse</label>
                                <h2 class="text-success fw-bold mb-0">₹ @(((decimal)Model.Budget).ToString("N0"))</h2>
                                <div class="progress mt-3" style="height: 8px; background-color: #0f172a;">
                                    <div class="progress-bar bg-success shadow-sm" role="progressbar" style="width: 100%"></div>
                                </div>
                                <p class="small text-muted mt-2 mb-0">Live auction buying power</p>
                            </div>
                        </div>

                        @* Squad Stats *@
                        <div class="col-sm-6">
                            <div class="p-4 rounded-4 border border-secondary shadow-sm" style="background: linear-gradient(145deg, #1e293b, #0f172a);">
                                <label class="text-secondary small text-uppercase fw-bold mb-2 d-block">Squad Strength</label>
                                <h2 class="text-info fw-bold mb-0">
                                    @(Model.Players?.Count ?? 0) <span class="fs-5 text-secondary">/ 25</span>
                                </h2>
                                <div class="progress mt-3" style="height: 8px; background-color: #0f172a;">
                                    @{
                                        var squadPercent = ((Model.Players?.Count ?? 0) / 25.0) * 100;
                                    }
                                    <div class="progress-bar bg-info" role="progressbar" style="width: @squadPercent%"></div>
                                </div>
                                <p class="small text-muted mt-2 mb-0">Slots remaining: @(25 - (Model.Players?.Count ?? 0))</p>
                            </div>
                        </div>
                    </div>

                    @* Metadata Table *@
                    <div class="mt-5 pt-4 border-top border-secondary">
                        <h6 class="text-secondary text-uppercase fw-bold mb-4">Registration Details</h6>
                        <div class="row g-3">
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block small">System ID</span>
                                <span class="font-monospace text-warning fw-bold">#FRN-@(Model.Id.ToString("D4"))</span>
                            </div>
                            <div class="col-6 col-md-4">
                                <span class="text-muted d-block small">Compliance Status</span>
                                <span class="badge bg-success-subtle text-success border border-success">Verified Active</span>
                            </div>
                            <div class="col-12 col-md-4">
                                <span class="text-muted d-block small">Last Audited</span>
                                <span class="text-white">@DateTime.Now.ToString("MMM yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-accent border-top border-secondary text-center py-3">
                    <span class="text-secondary small">Data locked for the 2026 Auction Season</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-accent {
        background-color: #1e293b;
    }

    .tracking-tight {
        letter-spacing: -0.5px;
    }

    .shadow-inner {
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.5);
    }

    /* Progress Bar Glow */
    .progress-bar {
        box-shadow: 0 0 10px rgba(25, 135, 84, 0.5);
    }
</style>