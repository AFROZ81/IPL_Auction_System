@model IEnumerable<IPLAuctionSystem.Models.Player>

@{
    ViewData["Title"] = "Player Roster";
    var teams = ViewBag.Teams as IEnumerable<IPLAuctionSystem.Models.Team>;
}

@functions {
    public string FormatCurrency(decimal amount)
    {
        if (amount >= 10000000) return $"₹ {(amount / 10000000).ToString("0.##")} Cr";
        if (amount >= 100000) return $"₹ {(amount / 100000).ToString("0.##")} L";
        return $"₹ {amount.ToString("N0")}";
    }

    public string GetCategoryClass(string category)
    {
        return category?.ToLower().Trim() switch
        {
            "batsman" => "bg-primary",
            "bowler" => "bg-danger",
            "all-rounder" => "bg-info",
            "wicketkeeper" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}

<div class="container-fluid py-4 bg-black" style="min-height: 100vh;">
    @* --- 1. HEADER SECTION --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h1 class="text-warning fw-bold mb-0">
                <i class="fa-solid fa-bat-ball me-2"></i>PLAYER ROSTER
            </h1>
            <p class="text-secondary mb-0">Elite talent management for the 2026 Season.</p>
        </div>
        <a asp-action="Create" class="btn btn-warning btn-lg shadow hover-lift fw-bold">
            <i class="fa-solid fa-user-plus me-2"></i>Add Player
        </a>
    </div>

    @* --- 2. STATISTICS CARDS --- *@
    <div class="row g-4 mb-5 px-2">
        <div class="col-md-4">
            <div class="card bg-dark border-secondary p-3 text-center h-100 shadow-sm border-top border-4 border-info">
                <small class="text-secondary text-uppercase fw-bold ls-1">Total Pool</small>
                <h2 class="text-white mb-0 fw-bold">@Model.Count()</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary p-3 text-center h-100 shadow-sm border-top border-4 border-success">
                <small class="text-secondary text-uppercase fw-bold ls-1">Sold</small>
                @* Logic: IsSold must be true AND price must be > 0 *@
                <h2 class="text-success mb-0 fw-bold">@Model.Count(p => p.IsSold && p.SoldPrice > 0)</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark border-secondary p-3 text-center h-100 shadow-sm border-top border-4 border-warning">
                <small class="text-secondary text-uppercase fw-bold ls-1">Remaining</small>
                <h2 class="text-warning mb-0 fw-bold">@Model.Count(p => !p.IsSold)</h2>
            </div>
        </div>
    </div>

    @* --- 3. FILTER & TOOLBAR SECTION --- *@
    <div class="d-flex justify-content-between align-items-center mb-3 mx-2">
        <div class="d-flex align-items-center gap-3">
            <span class="text-secondary small fw-bold text-uppercase"><i class="fa-solid fa-filter me-1"></i> Filter:</span>
            <div class="btn-group shadow-sm bg-dark rounded-3 p-1 border border-secondary" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary active filter-btn" onclick="filterCategory('all', this)">All</button>
                <button type="button" class="btn btn-sm btn-outline-primary filter-btn" onclick="filterCategory('batsman', this)">Batsmen</button>
                <button type="button" class="btn btn-sm btn-outline-danger filter-btn" onclick="filterCategory('bowler', this)">Bowlers</button>
                <button type="button" class="btn btn-sm btn-outline-info filter-btn" onclick="filterCategory('all-rounder', this)">All-Rounders</button>
                <button type="button" class="btn btn-sm btn-outline-warning filter-btn" onclick="filterCategory('wicketkeeper', this)">WKs</button>
            </div>
        </div>
        <div class="text-secondary small">
            Showing <span id="visibleCount" class="text-white fw-bold">@Model.Count()</span> Players
        </div>
    </div>

    @* --- 4. MAIN TABLE CARD --- *@
    <div class="card bg-dark shadow-lg border-secondary overflow-hidden mx-2">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" id="playerTable">
                <thead class="table-light text-dark">
                    <tr>
                        <th class="ps-4">PLAYER INFO</th>
                        <th>CATEGORY</th>
                        <th>BASE PRICE</th>
                        <th>SOLD PRICE</th>
                        <th>STATUS</th>
                        <th>FRANCHISE</th>
                        <th class="text-center">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="player-row" data-category="@item.Category?.ToLower().Trim()">
                            <td class="ps-4">
                                <div class="d-flex align-items-center py-2">
                                    <div class="me-3">
                                        @if (!string.IsNullOrEmpty(item.ProfilePicture))
                                        {
                                            <img src="~/images/players/@item.ProfilePicture"
                                                 class="rounded-circle border border-secondary shadow-sm"
                                                 style="width: 48px; height: 48px; object-fit: cover;"
                                                 alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center border border-dark"
                                                 style="width: 48px; height: 48px;">
                                                <i class="fa-solid fa-user text-white-50"></i>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <span class="fw-bold fs-5 text-white d-block">@item.Name</span>
                                        <small class="text-secondary text-uppercase" style="font-size: 0.7rem;">ID: #PLY-@item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @GetCategoryClass(item.Category) rounded-pill px-3 py-2 text-uppercase" style="min-width: 100px;">
                                    @item.Category
                                </span>
                            </td>
                            <td class="text-secondary fw-semibold">@FormatCurrency((decimal)item.BasePrice)</td>
                            <td>
                                @if (item.IsSold && item.SoldPrice > 0)
                                {
                                    <span class="text-success fw-bold fs-5">@FormatCurrency((decimal)item.SoldPrice)</span>
                                }
                                else
                                {
                                    <span class="text-muted opacity-50">---</span>
                                }
                            </td>
                            <td>
                                @if (item.IsSold && item.SoldPrice > 0)
                                {
                                    <span class="badge bg-success shadow-sm"><i class="fa-solid fa-check me-1"></i> SOLD</span>
                                }
                                else if (item.IsSold && item.SoldPrice == 0)
                                {
                                    <span class="badge bg-danger shadow-sm"><i class="fa-solid fa-circle-xmark me-1"></i> UNSOLD</span>
                                }
                                else
                                {
                                    <span class="badge bg-outline-warning text-warning border border-warning"><i class="fa-solid fa-clock me-1"></i> PENDING</span>
                                }
                            </td>
                            <td>
                                @if (item.IsSold && item.Team != null)
                                {
                                    <span class="text-info fw-bold">@item.Team.Name</span>
                                }
                                else
                                {
                                    <span class="text-secondary small italic">Available</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-2">
                                    @* Show SELL button only if Pending OR Unsold (allows re-auctioning unsold players) *@
                                    @if (!item.IsSold || (item.IsSold && item.SoldPrice == 0))
                                    {
                                        <button class="btn btn-sell-action shadow-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#sellModal-@item.Id"
                                                title="Finalize Sale">
                                            <i class="fa-solid fa-gavel me-1"></i> SELL
                                        </button>
                                    }

                                    <div class="action-utility-group shadow-sm">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn-util util-details" title="View Profile">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn-util util-edit" title="Edit Player">
                                            <i class="fa-solid fa-user-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn-util util-delete" title="Remove Player">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    </div>
                                </div>

                                @* Sell Modal *@
                                @if (!item.IsSold || (item.IsSold && item.SoldPrice == 0))
                                {
                                    <div class="modal fade text-start" id="sellModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content bg-dark border-secondary">
                                                <div class="modal-header border-secondary bg-accent">
                                                    <h5 class="modal-title text-white fw-bold">Finalize Sale: @item.Name</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="SellPlayer" method="post">
                                                    <div class="modal-body p-4">
                                                        <input type="hidden" name="playerId" value="@item.Id" />
                                                        <div class="mb-4">
                                                            <label class="text-secondary small fw-bold text-uppercase mb-2 d-block">Purchasing Team</label>
                                                            <select name="teamId" class="form-select bg-dark text-white border-secondary py-2" required>
                                                                <option value="">-- Choose Franchise --</option>
                                                                @if (teams != null)
                                                                {
                                                                    foreach (var team in teams)
                                                                    {
                                                                        <option value="@team.Id">@team.Name (Purse: @FormatCurrency((decimal)team.Budget))</option>
                                                                    }
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="text-secondary small fw-bold text-uppercase mb-2 d-block">Hammer Price (INR)</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-secondary border-secondary text-white">₹</span>
                                                                <input type="number" name="bidAmount" class="form-control bg-dark text-white border-secondary" min="@item.BasePrice" value="@item.BasePrice" required />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-secondary">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-warning px-4 fw-bold">CONFIRM SALE</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* ... (Styles remain the same as your original provided code) ... */
    .bg-black {
        background-color: #0f172a;
    }

    .bg-accent {
        background-color: #1e293b;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .hover-lift {
        transition: transform 0.2s;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
        }

    .table-dark {
        --bs-table-bg: transparent;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.03) !important;
    }

    .filter-btn {
        border-color: #334155;
        color: #94a3b8;
        transition: all 0.2s;
    }

        .filter-btn.active {
            color: #fff !important;
            pointer-events: none;
        }

    .btn-outline-primary.active {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .btn-outline-danger.active {
        background-color: #dc3545;
        border-color: #dc3545;
    }

    .btn-outline-info.active {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
    }

    .btn-outline-warning.active {
        background-color: #ffc107;
        border-color: #ffc107;
        color: #000 !important;
    }

    .btn-outline-secondary.active {
        background-color: #475569;
        border-color: #475569;
    }

    .player-row {
        transition: opacity 0.3s ease;
    }

    .btn-sell-action {
        background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
        color: #000;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.5px;
        padding: 6px 14px;
        border-radius: 6px;
        border: none;
        transition: all 0.2s ease;
        text-transform: uppercase;
    }

        .btn-sell-action:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
            background: #fbbf24;
        }

    .action-utility-group {
        display: flex;
        background: rgba(30, 41, 59, 0.7);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        padding: 2px;
    }

    .btn-util {
        color: #94a3b8;
        padding: 6px 10px;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .util-details:hover {
        color: #fff !important;
        background: rgba(255, 255, 255, 0.1);
    }

    .util-edit:hover {
        color: #38bdf8 !important;
        background: rgba(56, 189, 248, 0.1);
    }

    .util-delete:hover {
        color: #fb7185 !important;
        background: rgba(251, 113, 133, 0.1);
    }
</style>

@section Scripts {
    <script>
        function filterCategory(category, element) {
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            element.classList.add('active');

            const rows = document.querySelectorAll('.player-row');
            let count = 0;

            rows.forEach(row => {
                const rowCategory = row.getAttribute('data-category');
                if (category === 'all' || rowCategory === category) {
                    row.style.display = "";
                    count++;
                } else {
                    row.style.display = "none";
                }
            });
            document.getElementById('visibleCount').innerText = count;
        }
    </script>
}