@model IEnumerable<IPLAuctionSystem.Models.Player>

@{
    ViewData["Title"] = "Player Roster";
}

@functions {
    public string FormatCurrency(decimal amount)
    {
        if (amount >= 10000000) return $"₹ {(amount / 10000000).ToString("0.##")} Cr";
        if (amount >= 100000) return $"₹ {(amount / 100000).ToString("0.##")} L";
        return $"₹ {amount.ToString("N0")}";
    }

    public string GetCategoryClass(string category)
    {
        return category?.ToLower() switch
        {
            "batsman" => "bg-primary",
            "bowler" => "bg-danger",
            "all-rounder" => "bg-info",
            "wicketkeeper" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }
}

<div class="container-fluid py-4 bg-black" style="min-height: 100vh;">
    @* Header Section *@
    <div class="d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h1 class="text-warning fw-bold mb-0">
                <i class="fa-solid fa-bat-ball me-2"></i>PLAYER ROSTER
            </h1>
            <p class="text-secondary">Review and manage the elite talent pool for the 2026 season.</p>
        </div>
        <a asp-action="Create" class="btn btn-warning btn-lg shadow hover-lift fw-bold">
            <i class="fa-solid fa-user-plus me-2"></i>Add New Player
        </a>
    </div>

    @* Statistics Cards *@
    <div class="row g-4 mb-4 px-2">
        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-center h-100 shadow-sm">
                <small class="text-secondary text-uppercase fw-bold ls-1">Total Pool</small>
                <h2 class="text-white mb-0 fw-bold">@Model.Count()</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-center h-100 shadow-sm border-bottom border-success border-4">
                <small class="text-secondary text-uppercase fw-bold ls-1">Sold</small>
                <h2 class="text-success mb-0 fw-bold">@Model.Count(p => p.IsSold)</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary p-3 text-center h-100 shadow-sm border-bottom border-warning border-4">
                <small class="text-secondary text-uppercase fw-bold ls-1">Remaining</small>
                <h2 class="text-warning mb-0 fw-bold">@Model.Count(p => !p.IsSold)</h2>
            </div>
        </div>
    </div>

    @* Main Table *@
    <div class="card bg-dark shadow-lg border-secondary overflow-hidden mx-2">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-light text-dark">
                    <tr>
                        <th class="ps-4">PLAYER INFO</th>
                        <th>CATEGORY</th>
                        <th>BASE PRICE</th>
                        <th>SOLD PRICE</th>
                        <th>STATUS</th>
                        <th>FRANCHISE</th>
                        <th class="text-center">AUCTION ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center py-2">
                                    <div class="me-3">
                                        @if (!string.IsNullOrEmpty(item.ProfilePicture))
                                        {
                                            <img src="~/images/players/@item.ProfilePicture"
                                                 class="rounded-circle border border-secondary shadow-sm"
                                                 style="width: 48px; height: 48px; object-fit: cover;"
                                                 alt="@item.Name" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center border border-dark shadow-sm"
                                                 style="width: 48px; height: 48px;">
                                                <i class="fa-solid fa-user text-white-50"></i>
                                            </div>
                                        }
                                    </div>
                                    <div>
                                        <span class="fw-bold fs-5 text-white d-block">@item.Name</span>
                                        <small class="text-secondary text-uppercase" style="font-size: 0.7rem;">ID: #PLY-@item.Id</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge @GetCategoryClass(item.Category) rounded-pill px-3 py-2 text-uppercase">
                                    @item.Category
                                </span>
                            </td>
                            <td class="text-secondary fw-semibold">
                                @FormatCurrency((decimal)item.BasePrice)
                            </td>
                            <td>
                                @if (item.IsSold)
                                {
                                    <span class="text-success fw-bold fs-5">@FormatCurrency((decimal)item.SoldPrice)</span>
                                }
                                else
                                {
                                    <span class="text-muted opacity-50">---</span>
                                }
                            </td>
                            <td>
                                @if (item.IsSold)
                                {
                                    <span class="badge bg-success shadow-sm"><i class="fa-solid fa-check me-1"></i> SOLD</span>
                                }
                                else
                                {
                                    <span class="badge bg-outline-warning text-warning border border-warning"><i class="fa-solid fa-clock me-1"></i> PENDING</span>
                                }
                            </td>
                            <td>
                                <span class="text-info fw-bold">@(item.Team?.Name ?? "Available")</span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group shadow-sm">
                                    @if (!item.IsSold)
                                    {
                                        <button class="btn btn-warning btn-sm px-3" data-bs-toggle="modal" data-bs-target="#sellModal-@item.Id" title="Finalize Sale">
                                            <i class="fa-solid fa-gavel me-1"></i> Sell
                                        </button>
                                    }
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>

                                @* Sell Player Modal *@
                                @if (!item.IsSold)
                                {
                                    <div class="modal fade text-start" id="sellModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content bg-dark border-secondary">
                                                <div class="modal-header border-secondary bg-accent">
                                                    <h5 class="modal-title text-white fw-bold">
                                                        <i class="fa-solid fa-gavel text-warning me-2"></i>Finalize Sale: @item.Name
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="SellPlayer" method="post">
                                                    <div class="modal-body p-4">
                                                        <input type="hidden" name="playerId" value="@item.Id" />

                                                        <div class="mb-4">
                                                            <label class="text-secondary small fw-bold text-uppercase mb-2 d-block">Select Purchasing Team</label>
                                                            <select name="teamId" class="form-select bg-dark text-white border-secondary py-2" required>
                                                                <option value="">-- Choose Franchise --</option>
                                                                @foreach (var team in (IEnumerable<IPLAuctionSystem.Models.Team>)ViewBag.Teams)
                                                                {
                                                                    <option value="@team.Id">@team.Name (Purse: @FormatCurrency((decimal)team.Budget))</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <div class="mb-3">
                                                            <label class="text-secondary small fw-bold text-uppercase mb-2 d-block">Final Hammer Price (INR)</label>
                                                            <div class="input-group">
                                                                <span class="input-group-text bg-secondary border-secondary text-white">₹</span>
                                                                <input type="number" name="bidAmount" class="form-control bg-dark text-white border-secondary py-2"
                                                                       min="@item.BasePrice" value="@item.BasePrice" required />
                                                            </div>
                                                            <small class="text-muted mt-2 d-block">Min. Bid must be >= Base Price (@FormatCurrency((decimal)item.BasePrice))</small>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-secondary">
                                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-warning px-4 fw-bold shadow">
                                                            CONFIRM SALE
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-black {
        background-color: #0f172a;
    }

    .bg-accent {
        background-color: #1e293b;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .hover-lift {
        transition: transform 0.2s;
    }

        .hover-lift:hover {
            transform: translateY(-2px);
        }

    .table-dark {
        --bs-table-bg: transparent;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.05) !important;
    }

    .form-select option {
        background-color: #1e293b;
    }
</style>