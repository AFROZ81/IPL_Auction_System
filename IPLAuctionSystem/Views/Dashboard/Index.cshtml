@model IEnumerable<IPLAuctionSystem.Models.Team>

@{
    ViewData["Title"] = "Auction Intelligence 2026";

    // Summing Budget (Budget is likely non-nullable decimal)
    var totalRemainingBudget = Model.Sum(t => (decimal)t.Budget);

    // Summing SoldPrice (Sum returns null if list is empty, so we use decimal?)
    var totalSpent = Model.Sum(t => t.Players?.Sum(p => (decimal?)p.SoldPrice) ?? 0m);

    var totalLeagueCapacity = totalSpent + totalRemainingBudget;

    var liquidityPercent = totalLeagueCapacity > 0
        ? (totalRemainingBudget / totalLeagueCapacity) * 100
        : 100;
}

@functions {
    public string FormatCurrency(decimal amount)
    {
        if (amount >= 10000000) return $"₹ {(amount / 10000000).ToString("0.##")} Cr";
        if (amount >= 100000) return $"₹ {(amount / 100000).ToString("0.##")} L";
        return $"₹ {amount.ToString("N0")}";
    }

    public string GetShortName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "";
        var parts = fullName.Split(' ');
        if (parts.Length == 1) return fullName.Substring(0, Math.Min(3, fullName.Length)).ToUpper();
        return string.Join("", parts.Select(p => p[0])).ToUpper();
    }
}

<div class="analytics-wrapper py-4 bg-dark-custom">
    @* --- TOP METRICS --- *@
    <div class="container-fluid mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="stat-card border-yellow">
                    <span class="label">TOP ACQUISITION</span>
                    <h2 class="value text-white">@(ViewBag.TopPlayer?.Name?.ToUpper() ?? "MARKET OPEN")</h2>
                    <span class="sub-value text-success">@FormatCurrency(ViewBag.TopPlayer?.SoldPrice ?? 0m)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card border-green">
                    <span class="label">TOTAL CAPITAL DEPLOYED</span>
                    <h2 class="value text-white">@FormatCurrency(totalSpent)</h2>
                    <div class="progress mt-2" style="height: 4px; background: #222;">
                        <div class="progress-bar bg-success" style="width: @((totalSpent / totalLeagueCapacity) * 100)%"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card border-info">
                    <span class="label">LEAGUE LIQUIDITY</span>
                    <h2 class="value text-white">@liquidityPercent.ToString("0.#")%</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row g-4">
            @* --- CHARTS SECTION --- *@
            <div class="col-xl-3 col-lg-4">
                <div class="glass-card h-100">
                    <div class="card-header-custom">
                        <i class="fa-solid fa-wallet text-warning me-2"></i> HIGHEST PURSE REMAINING
                    </div>
                    <div class="bidder-list">
                        @foreach (var team in Model.OrderByDescending(t => t.Budget).Take(5))
                        {
                            <div class="bidder-item">
                                <div class="name">@team.Name.ToUpper()</div>
                                <div class="price text-warning">@FormatCurrency((decimal)team.Budget)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-xl-6 col-lg-8">
                <div class="glass-card p-4">
                    <h6 class="text-white fw-bold mb-4 small text-uppercase">Remaining Budget By Franchise</h6>
                    <div style="height: 300px;">
                        <canvas id="budgetChart"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-12">
                <div class="glass-card p-4 h-100">
                    <h6 class="text-white fw-bold text-center mb-4 small text-uppercase">Spending Distribution</h6>
                    <div style="height: 250px;">
                        <canvas id="shareChart"></canvas>
                    </div>
                </div>
            </div>

            @* --- FRANCHISE TABLE WITH EXPANDABLE SQUADS --- *@
            <div class="col-12">
                <div class="glass-card">
                    <div class="table-responsive">
                        <table class="table table-dark custom-table mb-0">
                            <thead>
                                <tr>
                                    <th>FRANCHISE</th>
                                    <th>SQUAD COMPLETION</th>
                                    <th>PURSE LEFT</th>
                                    <th class="text-end">MAX SINGLE BID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in Model)
                                {
                                    var squadCount = team.Players?.Count ?? 0;
                                    var remainingSlots = 25 - squadCount;
                                    var reservedForSquad = remainingSlots * 2000000m;
                                    var maxBid = (decimal)team.Budget - reservedForSquad;
                                    var collapseId = "squad_" + team.Id;

                                    <tr class="align-middle clickable-row" data-bs-toggle="collapse" data-bs-target="#@collapseId" style="cursor: pointer;">
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-chevron-right me-3 text-muted collapse-arrow"></i>
                                                <div>
                                                    <div class="fw-bold text-white">@team.Name.ToUpper()</div>
                                                    <div class="tiny text-muted text-uppercase">Click to view roster</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="me-2 small">@squadCount / 25</span>
                                                <div class="progress flex-grow-1" style="height:4px; max-width:100px; background: #222;">
                                                    <div class="progress-bar @(squadCount > 20 ? "bg-success" : "bg-info")" style="width: @(squadCount * 4)%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-warning fw-bold">@FormatCurrency((decimal)team.Budget)</td>
                                        <td class="text-end text-white fw-bold">
                                            <span class="text-success">@FormatCurrency(maxBid > 0 ? maxBid : 0)</span>
                                        </td>
                                    </tr>

                                    <tr class="collapse-row">
                                        <td colspan="4" class="p-0 border-0">
                                            <div class="collapse bg-squad-panel shadow-inner" id="@collapseId">
                                                <div class="p-4">
                                                    <div class="row g-3">
                                                        @if (team.Players != null && team.Players.Any())
                                                        {
                                                            foreach (var player in team.Players)
                                                            {
                                                                <div class="col-xxl-2 col-lg-3 col-md-4 col-6">
                                                                    <div class="player-mini-card">
                                                                        <div class="player-img-wrapper">
                                                                            @if (!string.IsNullOrEmpty(player.ProfilePicture))
                                                                            {
                                                                                <img src="~/images/players/@player.ProfilePicture" alt="@player.Name" asp-append-version="true">
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="h-100 d-flex align-items-center justify-content-center bg-dark">
                                                                                    <i class="fa-solid fa-user text-white-50 fa-2x"></i>
                                                                                </div>
                                                                            }
                                                                            <span class="category-badge">@player.Category</span>
                                                                        </div>
                                                                        <div class="player-details">
                                                                            <div class="p-name">@player.Name</div>
                                                                            <div class="p-cost">@FormatCurrency(player.SoldPrice)</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="col-12 text-center py-5">
                                                                <div class="text-muted small"><i class="fa-solid fa-circle-info me-2"></i>No players signed yet.</div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-dark-custom {
        background-color: #0b0e14;
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .stat-card {
        background: #151921;
        padding: 20px;
        border-radius: 4px;
        border-left: 4px solid #333;
    }

    .border-yellow {
        border-left-color: #ffc107;
    }

    .border-green {
        border-left-color: #28a745;
    }

    .border-info {
        border-left-color: #0dcaf0;
    }

    .stat-card .label {
        color: #888;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        display: block;
        margin-bottom: 5px;
    }

    .stat-card .value {
        font-size: 1.4rem;
        font-weight: 900;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .stat-card .sub-value {
        font-size: 0.8rem;
        font-weight: 600;
    }

    .glass-card {
        background: #151921;
        border: 1px solid #2d343f;
        border-radius: 8px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #1c222d;
        padding: 15px 20px;
        color: #fff;
        font-weight: 800;
        font-size: 0.75rem;
        border-bottom: 1px solid #2d343f;
        letter-spacing: 1px;
    }

    .bidder-item {
        padding: 12px 20px;
        border-bottom: 1px solid #232a35;
    }

        .bidder-item .name {
            color: #888;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .bidder-item .price {
            font-size: 1rem;
            font-weight: 800;
        }

    .custom-table thead th {
        background: #1c222d;
        color: #666;
        font-size: 0.65rem;
        border: none;
        padding: 15px 20px;
        letter-spacing: 1px;
    }

    .custom-table tbody td {
        padding: 15px 20px;
        border-color: #232a35;
        vertical-align: middle;
        color: #ccc;
    }

    .tiny {
        font-size: 0.6rem;
        font-weight: 700;
    }

    /* SQUAD GRID STYLES */
    .bg-squad-panel {
        background: #0f1218;
        border-bottom: 1px solid #2d343f;
    }

    .clickable-row:hover {
        background: #1c222d !important;
    }

    .collapse-arrow {
        transition: transform 0.3s;
    }

    .clickable-row[aria-expanded="true"] .collapse-arrow {
        transform: rotate(90deg);
        color: #ffc107 !important;
    }

    .player-mini-card {
        background: #1c222d;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid #2d343f;
        transition: transform 0.2s;
    }

        .player-mini-card:hover {
            transform: translateY(-3px);
            border-color: #ffc107;
        }

    .player-img-wrapper {
        position: relative;
        height: 140px;
        background: #0b0e14;
    }

        .player-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .category-badge {
        position: absolute;
        bottom: 5px;
        right: 5px;
        font-size: 0.55rem;
        background: rgba(0,0,0,0.85);
        color: #ffc107;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 800;
        text-transform: uppercase;
        border: 1px solid rgba(255,193,7,0.3);
    }

    .player-details {
        padding: 10px;
    }

    .p-name {
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .p-cost {
        color: #28a745;
        font-size: 0.75rem;
        font-weight: 800;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const fullNames = @Html.Raw(Json.Serialize(Model.Select(t => t.Name.ToUpper())));
        const shortNames = @Html.Raw(Json.Serialize(Model.Select(t => GetShortName(t.Name))));
        const budgets = @Html.Raw(Json.Serialize(Model.Select(t => t.Budget)));
        const spent = @Html.Raw(Json.Serialize(Model.Select(t => t.Players?.Sum(p => (decimal)p.SoldPrice) ?? 0m)));

        function jsFormat(v) {
            if (v >= 10000000) return '₹ ' + (v / 10000000).toFixed(1) + ' Cr';
            if (v >= 100000) return '₹ ' + (v / 100000).toFixed(1) + ' L';
            return '₹ ' + v.toLocaleString();
        }

        Chart.defaults.color = '#777';
        Chart.defaults.font.family = "'Inter', sans-serif";

        new Chart(document.getElementById('budgetChart'), {
            type: 'bar',
            data: {
                labels: shortNames,
                datasets: [{ data: budgets, backgroundColor: '#ffc107', barThickness: 25 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { callbacks: { title: (c) => fullNames[c[0].dataIndex], label: (c) => ' Remaining: ' + jsFormat(c.raw) } } },
                scales: { x: { grid: { display: false } }, y: { grid: { color: '#222' }, ticks: { callback: (v) => jsFormat(v) } } }
            }
        });

        new Chart(document.getElementById('shareChart'), {
            type: 'doughnut',
            data: {
                labels: fullNames,
                datasets: [{ data: spent, backgroundColor: ['#0ea5e9', '#6366f1', '#f43f5e', '#eab308', '#22c55e', '#d946ef', '#8b5cf6', '#f87171'], borderWidth: 0 }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '82%', plugins: { legend: { display: false } } }
        });
    </script>
}