@model IEnumerable<IPLAuctionSystem.Models.Team>

@{
    ViewData["Title"] = "Auction Intelligence 2026";
}

@functions {
    public string FormatCurrency(decimal amount)
    {
        if (amount >= 10000000) return $"₹ {(amount / 10000000).ToString("0.##")} Cr";
        if (amount >= 100000) return $"₹ {(amount / 100000).ToString("0.##")} L";
        return $"₹ {amount.ToString("N0")}";
    }
}

<div class="analytics-wrapper py-5">
    @* --- HEADER: Market Status --- *@
    <div class="container-fluid mb-5">
        <div class="d-flex justify-content-between align-items-end border-bottom border-secondary pb-4">
            <div>
                <span class="badge bg-danger mb-2 animate-pulse ls-1">● LIVE MARKET DATA</span>
                <h1 class="display-5 fw-900 text-white tracking-tighter mb-0">
                    AUCTION <span class="text-warning">INTELLIGENCE</span> <span class="fw-light text-secondary">2026</span>
                </h1>
            </div>
            <div class="text-end d-none d-md-block">
                <p class="text-secondary small mb-0 text-uppercase fw-bold">Market Liquidity</p>
                <h3 class="text-white mb-0 fw-black">94.2%</h3>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row g-4">
            @* --- LEFT COLUMN: Key Performance Indicators --- *@
            <div class="col-xl-3 col-lg-4">
                <div class="glass-card mb-4 overflow-hidden border-top-warning">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="icon-shape bg-warning-soft text-warning">
                                <i class="fa-solid fa-crown"></i>
                            </div>
                            <span class="text-secondary tiny fw-bold ls-1">RECORD BUY</span>
                        </div>
                        <h6 class="text-secondary text-uppercase small ls-1">Top Acquisition</h6>
                        <h2 class="text-white fw-bold ls-tight">@(ViewBag.TopPlayer?.Name ?? "Market Open")</h2>
                        <div class="text-success fs-4 fw-black mt-2">
                            @FormatCurrency(ViewBag.TopPlayer?.SoldPrice ?? 0m)
                        </div>
                    </div>
                </div>

                <div class="glass-card mb-4">
                    <div class="card-body p-4">
                        <h6 class="text-secondary text-uppercase small mb-3 ls-1">Capital Deployed</h6>
                        <h2 class="text-white fw-bold mb-3">
                            @FormatCurrency(Model.Sum(t => t.Players?.Sum(p => (decimal?)p.SoldPrice) ?? 0m))
                        </h2>
                        <div class="progress bg-dark-soft" style="height: 6px;">
                            <div class="progress-bar bg-warning shadow-warning" style="width: 72%"></div>
                        </div>
                        <p class="text-secondary tiny mt-2 mb-0">Aggregate Purse Exhaustion: 72%</p>
                    </div>
                </div>

                <div class="glass-card">
                    <div class="card-header bg-transparent border-secondary py-3">
                        <h6 class="text-white mb-0 small fw-bold text-uppercase ls-1">Aggressive Bidders</h6>
                    </div>
                    <ul class="list-group list-group-flush bg-transparent">
                        @foreach (var team in Model.OrderByDescending(t => t.Players?.Sum(p => p.SoldPrice)).Take(3))
                        {
                            <li class="list-group-item bg-transparent border-secondary d-flex justify-content-between align-items-center py-3">
                                <span class="text-secondary small fw-semibold">@team.Name.ToUpper()</span>
                                <span class="text-white fw-bold small">@FormatCurrency(team.Players?.Sum(p => (decimal)p.SoldPrice) ?? 0m)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            @* --- RIGHT COLUMN: Visualizations & Detailed Metrics --- *@
            <div class="col-xl-9 col-lg-8">
                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <div class="glass-card p-4 h-100">
                            <h6 class="text-white text-uppercase small mb-4 fw-bold ls-1">Purse Health Analysis</h6>
                            <div style="height: 320px;">
                                <canvas id="budgetChart"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="glass-card p-4 h-100 d-flex flex-column justify-content-center">
                            <h6 class="text-white text-uppercase small mb-4 fw-bold ls-1 text-center">Market Share</h6>
                            <div style="height: 220px;">
                                <canvas id="shareChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card border-0">
                    <div class="card-header bg-transparent border-secondary py-4 px-4">
                        <h5 class="text-white mb-0 fw-bold ls-tight">Franchise Financial Statements</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 custom-analytics-table">
                            <thead>
                                <tr>
                                    <th class="ps-4">TEAM IDENTITY</th>
                                    <th>SQUAD CAPACITY</th>
                                    <th>REMAINING PURSE</th>
                                    <th class="text-end pe-4">VALUATION</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="status-pill-container @(team.Budget < 100000000 ? "status-low" : "status-high")">
                                                    <span class="status-dot"></span>
                                                </div>
                                                <div class="ms-3">
                                                    <div class="text-white fw-bold ls-tight">@team.Name.ToUpper()</div>
                                                    <div class="text-secondary tiny fw-bold">ID: #2026-@team.Id</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center" style="max-width: 140px;">
                                                <div class="progress w-100 me-2" style="height: 4px; background: rgba(255,255,255,0.05);">
                                                    <div class="progress-bar bg-info" style="width: @((team.Players?.Count ?? 0) * 4)%"></div>
                                                </div>
                                                <span class="tiny text-secondary fw-bold">@(team.Players?.Count ?? 0)/25</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-white fw-semibold">@FormatCurrency((decimal)team.Budget)</span>
                                            @if (team.Budget < 50000000)
                                            {
                                                <span class="ms-2 tiny-badge text-danger">CRITICAL</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <span class="text-warning fw-black">@FormatCurrency(team.Players?.Sum(p => (decimal)p.SoldPrice) ?? 0m)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --glass: rgba(255, 255, 255, 0.03);
        --glass-border: rgba(255, 255, 255, 0.08);
        --bg-deep: #020617;
    }

    body {
        background-color: var(--bg-deep);
        font-family: 'Inter', sans-serif;
    }

    .fw-900 {
        font-weight: 900;
    }

    .fw-black {
        font-weight: 800;
    }

    .ls-1 {
        letter-spacing: 1px;
    }

    .ls-tight {
        letter-spacing: -0.5px;
    }

    .tiny {
        font-size: 0.65rem;
    }

    .tiny-badge {
        font-size: 0.55rem;
        font-weight: 900;
        padding: 2px 5px;
        border: 1px solid currentColor;
        border-radius: 4px;
    }

    .glass-card {
        background: var(--glass);
        backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
    }

    .border-top-warning {
        border-top: 3px solid #eab308 !important;
    }

    .status-pill-container {
        padding: 10px 4px;
        background: rgba(255,255,255,0.03);
        border-radius: 20px;
        display: flex;
        justify-content: center;
        width: 14px;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status-high .status-dot {
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
    }

    .status-low .status-dot {
        background: #ef4444;
        box-shadow: 0 0 8px #ef4444;
    }

    .icon-shape {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

    .bg-warning-soft {
        background: rgba(234, 179, 8, 0.1);
    }

    .bg-dark-soft {
        background: rgba(255, 255, 255, 0.05);
    }

    .custom-analytics-table thead th {
        background: rgba(255, 255, 255, 0.02);
        color: #64748b;
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        padding: 15px;
        border-bottom: 1px solid var(--glass-border);
    }

    .custom-analytics-table tbody td {
        padding: 16px 15px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .custom-analytics-table tbody tr:hover {
        background: rgba(255, 255, 255, 0.02) !important;
        cursor: default;
    }

    .animate-pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .5;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Data from Model
        const teamNames = @Html.Raw(Json.Serialize(Model.Select(t => t.Name.ToUpper())));
        const teamBudgets = @Html.Raw(Json.Serialize(Model.Select(t => t.Budget)));
        const teamSpent = @Html.Raw(Json.Serialize(Model.Select(t => t.Players?.Sum(p => (decimal)p.SoldPrice) ?? 0m)));

        // JavaScript Currency Formatter
        function jsFormatCurrency(value) {
            if (value >= 10000000) return '₹ ' + (value / 10000000).toFixed(2) + ' Cr';
            if (value >= 100000) return '₹ ' + (value / 100000).toFixed(2) + ' L';
            return '₹ ' + value.toLocaleString();
        }

        Chart.defaults.color = '#64748b';
        Chart.defaults.font.family = "'Inter', sans-serif";

        // Budget Analysis Chart
        new Chart(document.getElementById('budgetChart'), {
            type: 'bar',
            data: {
                labels: teamNames,
                datasets: [{
                    label: 'Liquidity',
                    data: teamBudgets,
                    backgroundColor: '#eab308',
                    borderRadius: 4,
                    barThickness: 12
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ' Remaining: ' + jsFormatCurrency(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(255,255,255,0.03)' },
                        border: { display: false },
                        ticks: {
                            callback: function(value) { return jsFormatCurrency(value); }
                        }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { color: '#f8fafc', font: { weight: '600', size: 10 } }
                    }
                }
            }
        });

        // Market Share Doughnut
        new Chart(document.getElementById('shareChart'), {
            type: 'doughnut',
            data: {
                labels: teamNames,
                datasets: [{
                    data: teamSpent,
                    backgroundColor: ['#38bdf8', '#818cf8', '#fb7185', '#fbbf24', '#34d399', '#f472b6', '#a78bfa', '#f87171'],
                    borderWidth: 0,
                    hoverOffset: 15
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '82%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                return label + ': ' + jsFormatCurrency(context.raw);
                            }
                        }
                    }
                }
            }
        });
    </script>
}