@model IEnumerable<IPLAuctionSystem.Models.Team>

@{
    ViewData["Title"] = "Auction Intelligence 2026";

    // 1. Calculate the actual current purse remaining across all teams
    var totalRemainingBudget = Model.Sum(t => (decimal)t.Budget);

    // 2. Calculate the original total capacity (Total Spent + Total Remaining)
    var totalSpent = Model.Sum(t => t.Players?.Sum(p => (decimal?)p.SoldPrice) ?? 0m);
    var totalLeagueCapacity = totalSpent + totalRemainingBudget;

    // 3. Liquidity is (What's left / Total Capacity)
    // We use a ternary check to prevent division by zero
    var liquidityPercent = totalLeagueCapacity > 0
        ? (totalRemainingBudget / totalLeagueCapacity) * 100
        : 100;
}

@functions {
    public string FormatCurrency(decimal amount)
    {
        if (amount >= 10000000) return $"₹ {(amount / 10000000).ToString("0.##")} Cr";
        if (amount >= 100000) return $"₹ {(amount / 100000).ToString("0.##")} L";
        return $"₹ {amount.ToString("N0")}";
    }

    public string GetShortName(string fullName)
    {
        if (string.IsNullOrEmpty(fullName)) return "";
        var parts = fullName.Split(' ');
        if (parts.Length == 1) return fullName.Substring(0, Math.Min(3, fullName.Length)).ToUpper();
        return string.Join("", parts.Select(p => p[0])).ToUpper();
    }
}

<div class="analytics-wrapper py-4 bg-dark-custom">
    @* --- DYNAMIC TOP METRICS --- *@
    <div class="container-fluid mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="stat-card border-yellow">
                    <span class="label">TOP ACQUISITION</span>
                    <h2 class="value text-white">@(ViewBag.TopPlayer?.Name?.ToUpper() ?? "MARKET OPEN")</h2>
                    <span class="sub-value text-success">@FormatCurrency(ViewBag.TopPlayer?.SoldPrice ?? 0m)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card border-green">
                    <span class="label">TOTAL CAPITAL DEPLOYED</span>
                    <h2 class="value text-white">@FormatCurrency(totalSpent)</h2>
                    <div class="progress mt-2" style="height: 4px; background: #222;">
                        <div class="progress-bar bg-success" style="width: @((totalSpent / totalLeagueCapacity) * 100)%"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card border-info">
                    <span class="label">LEAGUE LIQUIDITY</span>
                    @* Added ToString("0.#") to keep it clean (e.g., 85.5%) *@
                    <h2 class="value text-white">@liquidityPercent.ToString("0.#")%</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row g-4">
            @* --- LEFT: SPENDING POWER --- *@
            <div class="col-xl-3 col-lg-4">
                <div class="glass-card h-100">
                    <div class="card-header-custom">
                        <i class="fa-solid fa-wallet text-warning me-2"></i> HIGHEST PURSE REMAINING
                    </div>
                    <div class="bidder-list">
                        @foreach (var team in Model.OrderByDescending(t => t.Budget).Take(5))
                        {
                            <div class="bidder-item">
                                <div class="name">@team.Name.ToUpper()</div>
                                <div class="price text-warning">@FormatCurrency((decimal)team.Budget)</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* --- CENTER: PURSE HEALTH CHART --- *@
            <div class="col-xl-6 col-lg-8">
                <div class="glass-card p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="text-white fw-bold mb-0">REMAINING BUDGET BY FRANCHISE</h6>
                        <span class="badge bg-dark text-warning border border-warning tiny">LIVE DATA</span>
                    </div>
                    <div style="height: 300px;">
                        <canvas id="budgetChart"></canvas>
                    </div>
                </div>
            </div>

            @* --- RIGHT: MARKET SHARE --- *@
            <div class="col-xl-3 col-lg-12">
                <div class="glass-card p-4 h-100">
                    <h6 class="text-white fw-bold text-center mb-4">SPENDING DISTRIBUTION</h6>
                    <div style="height: 250px;">
                        <canvas id="shareChart"></canvas>
                    </div>
                </div>
            </div>

            @* --- BOTTOM: FINANCIAL STRATEGY TABLE --- *@
            <div class="col-12">
                <div class="glass-card">
                    <div class="table-responsive">
                        <table class="table table-dark custom-table mb-0">
                            <thead>
                                <tr>
                                    <th>FRANCHISE</th>
                                    <th>SQUAD COMPLETION</th>
                                    <th>PURSE LEFT</th>
                                    <th class="text-end">MAX SINGLE BID CAPABLE</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in Model)
                                {
                                    var squadCount = team.Players?.Count ?? 0;
                                    var remainingSlots = 25 - squadCount;
                                    var reservedForSquad = remainingSlots * 2000000m;
                                    var maxBid = (decimal)team.Budget - reservedForSquad;

                                    <tr>
                                        <td>
                                            <div class="fw-bold text-white">@team.Name.ToUpper()</div>
                                            <div class="tiny text-muted">STRENGTH: @(squadCount < 15 ? "CORE BUILDING" : "FESTERING")</div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="me-2">@squadCount / 25</span>
                                                <div class="progress flex-grow-1" style="height:4px; max-width:100px; background: #222;">
                                                    <div class="progress-bar @(squadCount > 20 ? "bg-success" : "bg-info")" style="width: @(squadCount * 4)%"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-warning fw-bold">@FormatCurrency((decimal)team.Budget)</td>
                                        <td class="text-end text-white fw-bold">
                                            <span class="text-success">@FormatCurrency(maxBid > 0 ? maxBid : 0)</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bg-dark-custom {
        background-color: #0b0e14;
        min-height: 100vh;
        font-family: 'Inter', sans-serif;
    }

    .stat-card {
        background: #151921;
        padding: 20px;
        border-radius: 4px;
        border-left: 4px solid #333;
    }

    .border-yellow {
        border-left-color: #ffc107;
    }

    .border-green {
        border-left-color: #28a745;
    }

    .border-info {
        border-left-color: #0dcaf0;
    }

    .stat-card .label {
        color: #888;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 1.5px;
        display: block;
        margin-bottom: 5px;
    }

    .stat-card .value {
        font-size: 1.6rem;
        font-weight: 900;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .stat-card .sub-value {
        font-size: 0.8rem;
        font-weight: 600;
    }

    .glass-card {
        background: #151921;
        border: 1px solid #2d343f;
        border-radius: 8px;
        overflow: hidden;
    }

    .card-header-custom {
        background: #1c222d;
        padding: 15px 20px;
        color: #fff;
        font-weight: 800;
        font-size: 0.75rem;
        border-bottom: 1px solid #2d343f;
        letter-spacing: 1px;
    }

    .bidder-item {
        padding: 12px 20px;
        border-bottom: 1px solid #232a35;
    }

        .bidder-item .name {
            color: #888;
            font-size: 0.7rem;
            font-weight: 700;
        }

        .bidder-item .price {
            font-size: 1rem;
            font-weight: 800;
        }

    .custom-table thead th {
        background: #1c222d;
        color: #666;
        font-size: 0.65rem;
        border: none;
        padding: 15px 20px;
        letter-spacing: 1px;
    }

    .custom-table tbody td {
        padding: 15px 20px;
        border-color: #232a35;
        vertical-align: middle;
        color: #ccc;
    }

    .tiny {
        font-size: 0.6rem;
        font-weight: 700;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Use Full Names for tooltips and Short Names for the Axis
        const fullTeamNames = @Html.Raw(Json.Serialize(Model.Select(t => t.Name.ToUpper())));
        const shortTeamNames = @Html.Raw(Json.Serialize(Model.Select(t => GetShortName(t.Name))));
        const teamBudgets = @Html.Raw(Json.Serialize(Model.Select(t => t.Budget)));
        const teamSpent = @Html.Raw(Json.Serialize(Model.Select(t => t.Players?.Sum(p => (decimal)p.SoldPrice) ?? 0m)));

        function jsFormatCurrency(value) {
            if (value >= 10000000) return '₹ ' + (value / 10000000).toFixed(1) + ' Cr';
            if (value >= 100000) return '₹ ' + (value / 100000).toFixed(1) + ' L';
            return '₹ ' + value.toLocaleString();
        }

        Chart.defaults.color = '#777';
        Chart.defaults.font.family = "'Inter', sans-serif";

        // Budget Chart - Fixed X-Axis Labels
        new Chart(document.getElementById('budgetChart'), {
            type: 'bar',
            data: {
                labels: shortTeamNames,
                datasets: [{
                    data: teamBudgets,
                    backgroundColor: '#ffc107',
                    hoverBackgroundColor: '#fff',
                    barThickness: 25
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: function(context) {
                                // Returns the full team name in the tooltip instead of abbreviation
                                return fullTeamNames[context[0].dataIndex];
                            },
                            label: function(context) {
                                return ' Remaining: ' + jsFormatCurrency(context.raw);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        ticks: {
                            font: { size: 11, weight: 'bold' },
                            maxRotation: 0, // Keeps labels horizontal
                            minRotation: 0
                        },
                        grid: { display: false }
                    },
                    y: {
                        grid: { color: '#222' },
                        ticks: { callback: (val) => jsFormatCurrency(val) }
                    }
                }
            }
        });

        // Share Chart (Doughnut)
        new Chart(document.getElementById('shareChart'), {
            type: 'doughnut',
            data: {
                labels: fullTeamNames,
                datasets: [{
                    data: teamSpent,
                    backgroundColor: ['#0ea5e9', '#6366f1', '#f43f5e', '#eab308', '#22c55e', '#d946ef', '#8b5cf6', '#f87171'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '82%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ' ' + context.label + ': ' + jsFormatCurrency(context.raw);
                            }
                        }
                    }
                }
            }
        });
    </script>
}